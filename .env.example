# Token do bot (Developer Portal → Bot → Reset Token). Obrigatório.
DISCORD_TOKEN=

# Quantos links o /link1 gera quando não passa quantidade
LINKS_PER_GEN=3
# Máximo de links por /link1
MAX_PER_GEN=10000
# Segundos de espera entre usos do /link1 por pessoa (0 = sem espera; admins ignoram)
COOLDOWN_SECONDS=0
# Mostra ⚠️ quando o estoque fica nesse número ou abaixo
LOW_STOCK=10

# IDs extras com acesso admin, separados por vírgula
# (o dono do bot no Developer Portal já é admin automaticamente)
ADMIN_USER_IDS=
ADMIN_ROLE_IDS=
